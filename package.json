{
  "name": "waveframe-youtube-player",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["client", "server"],
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm --filter @waveframe/server dev\" \"pnpm --filter @waveframe/client dev\"",
    "dev:client": "pnpm --filter @waveframe/client dev",
    "dev:server": "pnpm --filter @waveframe/server dev",
    "build": "pnpm --filter @waveframe/client build && pnpm --filter @waveframe/server build",
    "start": "pnpm --filter @waveframe/server start"
  },
  "devDependencies": { "concurrently": "^9.1.2", "typescript": "^5.8.3" }
}
